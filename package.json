{
  "name": "prismic-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm:next:dev\" \"npm:slicemachine\" --names \"next,slicemachine\" --prefix-colors blue,magenta",
    "next:dev": "next -p 1204",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "slicemachine": "start-slicemachine -p 1203",
    "setup": "npm run figma:sync && npm run buttons:sync",
    "figma:sync": "node scripts/figma-to-css.mjs",
    "buttons:sync": "node scripts/sync-button-variants.mjs",
    "slice:create": "node scripts/create-slice.mjs",
    "migrate:blog": "node scripts/migrate-blog.mjs"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.5.2",
    "@prismicio/client": "^7.21.8",
    "@prismicio/migrate": "^0.0.2",
    "@prismicio/next": "^2.2.4",
    "@prismicio/react": "^3.4.1",
    "@smakss/react-scroll-direction": "^4.3.1",
    "algoliasearch": "^5.52.1",
    "atd-icons": "^3.1.0",
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "embla-carousel-react": "^8.6.0",
    "form-data": "^4.0.6",
    "instantsearch.css": "^8.16.2",
    "mailgun.js": "^13.3.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-countup": "^6.5.3",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.76.1",
    "react-instantsearch": "^7.33.1",
    "sass": "^1.100.0",
    "slugify": "^1.6.9"
  },
  "devDependencies": {
    "@slicemachine/adapter-next": "^0.3.96",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "change-case": "^5.4.4",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "pluralize": "^8.0.0",
    "slice-machine-ui": "^2.21.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
